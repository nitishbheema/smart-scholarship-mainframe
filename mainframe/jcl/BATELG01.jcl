//BATELG01 JOB (SCHOLAR,BAT),'SCHOLARSHIP BATCH RUN',
//             CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL: BATELG01.JCL                                                 *
//* PURPOSE: MAIN PRODUCTION BATCH RUN FOR SCHOLARSHIP ELIGIBILITY    *
//*          EXECUTES COBOL PROGRAM MAIN0001                          *
//* STEPS:                                                            *
//*   STEP010 - CLEAN PREVIOUS EXECUTION OUTPUT DATASETS (IEFBR14)    *
//*   STEP020 - EXECUTE MAIN0001 (CORE COBOL PIPELINE)                *
//*   STEP030 - RECONCILE DB2 AUDIT LOG VIA IKJEFT01 (COND=(0,EQ))    *
//*-------------------------------------------------------------------*
//*
//* STEP 1: CLEANUP PRIOR OUTPUT FILES
//CLEAN01  EXEC PGM=IEFBR14
//SYSPRINT DD SYSOUT=*
//DEL01    DD DSN=USERID.SCHOLAR.DATA.ELIG.APPROVED,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//DEL02    DD DSN=USERID.SCHOLAR.DATA.ELIG.REJECTED,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//DEL03    DD DSN=USERID.SCHOLAR.DATA.DISB.PAYMENTS,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//DEL04    DD DSN=USERID.SCHOLAR.DATA.AUDIT.EXCEPTNS,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//DEL05    DD DSN=USERID.SCHOLAR.REPORT.SYSOUT.ARCHIVE,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,0)
//*
//* STEP 2: EXECUTE CORE COBOL BATCH APPLICATION (MAIN0001)
//RUNMAIN  EXEC PGM=MAIN0001
//STEPLIB  DD DSN=USERID.SCHOLAR.LOADLIB,DISP=SHR
//         DD DSN=CEE.SCEERUN,DISP=SHR
//* INPUTS:
//APPIN    DD DSN=USERID.SCHOLAR.DATA.APPL.SORTED,DISP=SHR
//STUMAST  DD DSN=USERID.SCHOLAR.VSAM.STUMAST.KSDS,DISP=SHR
//* OUTPUTS:
//ELGOUT   DD DSN=USERID.SCHOLAR.DATA.ELIG.APPROVED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960),
//            UNIT=SYSDA
//REJOUT   DD DSN=USERID.SCHOLAR.DATA.ELIG.REJECTED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960),
//            UNIT=SYSDA
//DISBOUT  DD DSN=USERID.SCHOLAR.DATA.DISB.PAYMENTS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960),
//            UNIT=SYSDA
//EXCOUT   DD DSN=USERID.SCHOLAR.DATA.AUDIT.EXCEPTNS,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960),
//            UNIT=SYSDA
//RPTOUT   DD DSN=USERID.SCHOLAR.REPORT.SYSOUT.ARCHIVE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(10,5)),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=27930),
//            UNIT=SYSDA
//* SYSTEM LOGGING & DIAGNOSTICS:
//SYSOUT   DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//*
//* STEP 3: DB2 AUDIT AND COMMIT STEP (EXECUTES ONLY IF RUNMAIN SUCCEEDED)
//AUDITDB2 EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT,RUNMAIN)
//STEPLIB  DD DSN=USERID.SCHOLAR.LOADLIB,DISP=SHR
//         DD DSN=DSN1.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DSN1)
    RUN PROGRAM(DB2AUD01) PLAN(SCHOLAR_PLAN)
  END
/*

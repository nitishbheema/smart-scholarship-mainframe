//DB2PREP  JOB (SCHOLAR,BAT),'DB2 PRECOMP & BIND',
//             CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL: DB2PREP.JCL                                                  *
//* PURPOSE: PRECOMPILE COBOL PROGRAM WITH EMBEDDED SQL (DB2AUD01),   *
//*          COMPILE WITH IGYCRCTL, BIND PACKAGE & PLAN IN DB2 SUBSYS *
//* TARGET DB2 SUBSYSTEM: DSN1                                        *
//*-------------------------------------------------------------------*
//*
//* STEP 1: DB2 PRECOMPILER (DSNHPC)
//PCSTEP   EXEC PGM=DSNHPC,PARM='HOST(COB2),SOURCE,XREF'
//STEPLIB  DD DSN=DSN1.SDSNLOAD,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(DB2AUD01),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSCIN   DD DSN=&&DSNHOUT,DISP=(MOD,PASS),
//            SPACE=(TRK,(5,2)),UNIT=SYSDA
//DBRMLIB  DD DSN=USERID.SCHOLAR.DBRM(DB2AUD01),DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* STEP 2: COMPILE MODIFIED COBOL SOURCE PRODUCED BY PRECOMPILER
//CMPSTEP  EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER',
//            COND=(4,LT,PCSTEP)
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=&&DSNHOUT,DISP=(OLD,DELETE)
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&OBJSET,DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7   DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* STEP 3: LINK-EDIT (BINDER) INTO LOAD LIBRARY
//LNKSTEP  EXEC PGM=IEWBLINK,PARM='LIST,MAP,RENT,XREF',
//            COND=(4,LT,CMPSTEP)
//SYSLMOD  DD DSN=USERID.SCHOLAR.LOADLIB(DB2AUD01),DISP=SHR
//SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//         DD DSN=DSN1.SDSNLOAD,DISP=SHR
//SYSLIN   DD *
  INCLUDE &&OBJSET
  INCLUDE DSNLOAD(DSNELI)
  ENTRY DB2AUD01
  NAME DB2AUD01(R)
/*
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(CYL,(2,1)),UNIT=SYSDA
//*
//* STEP 4: DB2 BIND PACKAGE AND PLAN VIA TSO BATCH DRIVER (IKJEFT01)
//BINDSTEP EXEC PGM=IKJEFT01,DYNAMNBR=20,
//            COND=(4,LT,LNKSTEP)
//STEPLIB  DD DSN=DSN1.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=USERID.SCHOLAR.DBRM,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DSN1)
    BIND PACKAGE(SCHOLAR_COLL) -
         MEMBER(DB2AUD01)      -
         ACT(REPLACE)          -
         ISOLATION(CS)         -
         VALIDATE(BIND)        -
         CURRENTDATA(NO)

    BIND PLAN(SCHOLAR_PLAN)    -
         PKLIST(SCHOLAR_COLL.*)-
         ACT(REPLACE)          -
         RETAIN                -
         ISOLATION(CS)
  END
/*

//SRTAPP01 JOB (SCHOLAR,BAT),'DFSORT APPLICATIONS',
//             CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL: SRTAPP01.JCL                                                 *
//* PURPOSE: SORT RAW SCHOLARSHIP APPLICATIONS BY STUDENT ID ASC      *
//*          AND APPLICATION DATE DESC; INTERCEPT IDENTICAL SUBMISSIONS*
//* TOOL: DFSORT (PGM=SORT)                                           *
//*-------------------------------------------------------------------*
//SRTSTEP  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=USERID.SCHOLAR.DATA.APPL.RAW,DISP=SHR
//SORTOUT  DD DSN=USERID.SCHOLAR.DATA.APPL.SORTED,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960),
//            UNIT=SYSDA
//XSUM     DD DSN=USERID.SCHOLAR.DATA.APPL.DUPSUM,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(2,1)),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27960),
//            UNIT=SYSDA
//SORTWK01 DD SPACE=(CYL,(2,1)),UNIT=SYSDA
//SORTWK02 DD SPACE=(CYL,(2,1)),UNIT=SYSDA
//SORTWK03 DD SPACE=(CYL,(2,1)),UNIT=SYSDA
//SYSIN    DD *
* SORT BY STUDENT ID (POS 11, LEN 10, CH, A) AND DATE (POS 27, 8, CH, D)
  SORT FIELDS=(11,10,CH,A,27,8,CH,D)
  RECORD LENGTH=120,TYPE=F
* WRITE DISCARDED DUPLICATE SUMMARY RECORDS TO XSUM DD
  SUM FIELDS=NONE,XSUM
/*

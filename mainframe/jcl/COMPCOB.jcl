//COMPCOB  JOB (SCHOLAR,BAT),'COMPILE & LINK COBOL',
//             CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*-------------------------------------------------------------------*
//* JCL: COMPCOB.JCL                                                  *
//* PURPOSE: COMPILE & LINK-EDIT COBOL APPLICATION MODULES            *
//*          COMPILER: IBM ENTERPRISE COBOL FOR z/OS (IGYCRCTL)       *
//*          LINKAGE EDITOR: BINDER (IEWBLINK)                        *
//*-------------------------------------------------------------------*
//*
//PROCLIB  JCLLIB ORDER=(IGY.V6R3M0.SIGYPROC)
//*
//* ===================================================================
//* STEP 1: COMPILE SUBROUTINE STU1001 (STUDENT VALIDATOR)
//* ===================================================================
//CMPSTU   EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER'
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(STU1001),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&LOADSET(STU1001),DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* ===================================================================
//* STEP 2: COMPILE SUBROUTINE SCH2001 (ELIGIBILITY ENGINE)
//* ===================================================================
//CMPSCH   EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER',
//            COND=(4,LT,CMPSTU)
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(SCH2001),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&LOADSET(SCH2001),DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* ===================================================================
//* STEP 3: COMPILE SUBROUTINE DUP3001 (DUPLICATE DETECTOR)
//* ===================================================================
//CMPDUP   EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER',
//            COND=(4,LT,CMPSCH)
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(DUP3001),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&LOADSET(DUP3001),DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* ===================================================================
//* STEP 4: COMPILE SUBROUTINE DIS4001 (DISBURSEMENT PROCESSOR)
//* ===================================================================
//CMPDIS   EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER',
//            COND=(4,LT,CMPDUP)
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(DIS4001),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&LOADSET(DIS4001),DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* ===================================================================
//* STEP 5: COMPILE SUBROUTINE RPT5001 (REPORT GENERATOR)
//* ===================================================================
//CMPRPT   EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER',
//            COND=(4,LT,CMPDIS)
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(RPT5001),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&LOADSET(RPT5001),DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* ===================================================================
//* STEP 6: COMPILE MAIN DRIVER MAIN0001 (MASTER CONTROLLER)
//* ===================================================================
//CMPMAIN  EXEC PGM=IGYCRCTL,PARM='LIB,SOURCE,XREF,MAP,NONUMBER',
//            COND=(4,LT,CMPRPT)
//STEPLIB  DD DSN=IGY.V6R3M0.SIGYCOMP,DISP=SHR
//SYSIN    DD DSN=USERID.SCHOLAR.COBOL(MAIN0001),DISP=SHR
//SYSLIB   DD DSN=USERID.SCHOLAR.COPYLIB,DISP=SHR
//SYSLIN   DD DSN=&&LOADSET(MAIN0001),DISP=(MOD,PASS),
//            SPACE=(TRK,(3,3)),UNIT=SYSDA
//SYSPRINT DD SYSOUT=*
//SYSUT1    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT2    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT3    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT4    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT5    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT6    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSUT7    DD SPACE=(CYL,(1,1)),UNIT=SYSDA
//*
//* ===================================================================
//* STEP 7: BINDER (LINK-EDIT) ALL OBJECT DECKS INTO EXECUTABLE LOADLIB
//* ===================================================================
//LNKMAIN  EXEC PGM=IEWBLINK,PARM='LIST,MAP,RENT,XREF',
//            COND=(4,LT,CMPMAIN)
//SYSLMOD  DD DSN=USERID.SCHOLAR.LOADLIB(MAIN0001),DISP=SHR
//SYSLIB   DD DSN=CEE.SCEELKED,DISP=SHR
//SYSLIN   DD *
  INCLUDE &&LOADSET(MAIN0001)
  INCLUDE &&LOADSET(STU1001)
  INCLUDE &&LOADSET(SCH2001)
  INCLUDE &&LOADSET(DUP3001)
  INCLUDE &&LOADSET(DIS4001)
  INCLUDE &&LOADSET(RPT5001)
  ENTRY MAIN0001
  NAME MAIN0001(R)
/*
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD SPACE=(CYL,(2,1)),UNIT=SYSDA
//*

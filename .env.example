# Smart Scholarship Environment Configuration
# Backend & API Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=your-secure-random-32-plus-characters-jwt-secret-string

# Administrator Initialization
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-strong-admin-password
ADMIN_EMAIL=admin@scholarship.edu

# Database URL
DATABASE_URL=postgresql://user:password@hostname:5432/scholarship_db?sslmode=require

# Frontend Vite Configuration (Required for Vercel / Production Frontend)
VITE_API_BASE_URL=https://smart-scholarship-backend.onrender.com
